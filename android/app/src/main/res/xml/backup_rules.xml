<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive files from backup -->
    <exclude domain="sharedpref" path="secure_prefs.xml" />
    <exclude domain="database" path="secure.db" />
    <exclude domain="file" path="keys/" />
    
    <!-- Include game data for backup -->
    <include domain="sharedpref" path="game_data.xml" />
    <include domain="sharedpref" path="user_preferences.xml" />
</full-backup-content>